{
  "name": "galaxy-andromeda-tabletop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @galaxy/client --filter @galaxy/server run dev",
    "dev:tunnel": "node harness/scripts/dev-tunnel.mjs",
    "build": "pnpm -r run build",
    "build:deploy": "pnpm --filter @galaxy/rules run build && pnpm --filter @galaxy/client run generate && pnpm --filter @galaxy/server run build",
    "start": "node packages/server/dist/index.js",
    "test": "pnpm --filter @galaxy/rules run build && pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "smoke": "tsx harness/agent-smoke/run-smoke.ts",
    "tabletop:print": "tsx harness/scripts/build-tabletop-print.mjs",
    "balance": "tsx harness/balance/run.ts",
    "balance:suite": "tsx harness/balance/suite.ts",
    "balance:table": "tsx harness/balance/table.ts",
    "balance:compare": "tsx harness/balance/compare.ts",
    "balance:trace": "tsx harness/balance/trace.ts",
    "balance:timing": "tsx harness/balance/timing.ts",
    "balance:start": "tsx harness/balance/start-state.ts",
    "balance:check": "tsx harness/balance/check-baseline.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
